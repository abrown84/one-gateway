{
  "name": "one-gateway",
  "version": "0.4.0",
  "description": "Drop-in OpenAI-compatible AI backend for any app — one base URL, swap models without code changes, with rate limits and security hardening. Gemini by default; OpenClaw optional.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "one-gateway-serve": "./bin/one-gateway-serve.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "import": "./dist/serve.js",
      "require": "./dist/serve.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "scripts",
    "README.md",
    "LICENSE",
    "Dockerfile",
    "examples"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/serve.ts src/bin/serve.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts src/serve.ts src/bin/serve.ts --format esm,cjs --dts --watch",
    "test": "tsx --test src/validate.test.ts src/serve.security.test.ts src/upstream.test.ts src/client.upstream.test.ts src/serve.demo.test.ts src/serve.callers.test.ts",
    "serve": "tsx --env-file-if-exists=.env src/bin/serve.ts",
    "smoke": "node scripts/smoke.mjs",
    "example": "node --env-file=.env examples/basic.mjs",
    "example:express": "npx tsx --env-file=.env examples/express.ts",
    "prepublishOnly": "npm run build",
    "audit": "npm audit --audit-level=high"
  },
  "keywords": [
    "openai-compatible",
    "gemini",
    "llm",
    "openai",
    "gateway",
    "ai-backend",
    "openclaw",
    "embeddings",
    "rate-limit",
    "model-routing"
  ],
  "author": "Alex B. <konfliktquake@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "express": "^5.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abrown84/one-gateway.git"
  },
  "homepage": "https://github.com/abrown84/one-gateway#readme",
  "bugs": {
    "url": "https://github.com/abrown84/one-gateway/issues"
  },
  "overrides": {
    "esbuild": ">=0.28.1"
  }
}
