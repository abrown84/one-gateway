# ── Upstream (Gemini by default; OpenClaw optional) ─────────────────────────
# Prefer ONE_GATEWAY_API_KEY or GEMINI_API_KEY for Gemini's OpenAI-compatible API.
ONE_GATEWAY_API_KEY=replace_me
# GEMINI_API_KEY=replace_me

# OpenAI-compatible upstream base (default: Gemini)
ONE_GATEWAY_UPSTREAM_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Legacy alias:
# ONE_GATEWAY_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Chat model (verified: gemini-3.8-flash)
ONE_GATEWAY_MODEL=gemini-3.8-flash

# Embeddings model (gemini-embedding-2; OpenAI-compat also documents *-preview)
ONE_GATEWAY_EMBEDDING_MODEL=gemini-embedding-2

# Optional: comma-separated fallback chat models
# ONE_GATEWAY_FALLBACKS=

# Tuning (optional)
ONE_GATEWAY_TEMPERATURE=0.2
ONE_GATEWAY_MAX_TOKENS=500
ONE_GATEWAY_TIMEOUT_MS=45000

# ── Optional OpenClaw alternative ───────────────────────────────────────────
# ONE_GATEWAY_UPSTREAM_URL=http://127.0.0.1:18789
# ONE_GATEWAY_TOKEN=your_openclaw_gateway_token
# ONE_GATEWAY_AGENT=main
# ONE_GATEWAY_MODEL=openclaw

# ── Public serve / playground (demo bill guards) ────────────────────────────
# HOST=127.0.0.1
# PORT=3005
# ONE_GATEWAY_ALLOWED_ORIGIN=https://yourdomain.com
# ONE_GATEWAY_TRUST_PROXY=true

# Client auth defaults OFF. Set to require Bearer auth from browsers/apps:
# ONE_GATEWAY_SERVE_AUTH_KEY=

# Model allowlist for the playground / public API
ONE_GATEWAY_ALLOWED_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Per-IP ~10/min and ~50/day; global daily cap across all IPs
ONE_GATEWAY_RATE_LIMIT=10
ONE_GATEWAY_DAILY_REQUEST_CAP=50
ONE_GATEWAY_GLOBAL_DAILY_CAP=2000
ONE_GATEWAY_MAX_PROMPT_CHARS=2000
ONE_GATEWAY_MAX_OUTPUT_TOKENS=512

# Required for examples/express.ts (local demo auth — not your upstream key)
# PROXY_API_KEY=dev-local-secret
